# TaskFlow Environment Configuration
# Copy this file to .env and fill in the values for your environment.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Path to the SQLite database file.
# The directory will be created automatically if it does not exist.
DATABASE_PATH=./data/taskflow.db

# ---------------------------------------------------------------------------
# Authentication (Better Auth)
# ---------------------------------------------------------------------------
# A strong random secret used to sign session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# The public URL where the auth endpoints are served.
# Must match the URL used by the client to call the auth API.
AUTH_URL=http://localhost:3000/api/auth

# ---------------------------------------------------------------------------
# Email / Notifications (Production)
# ---------------------------------------------------------------------------
# Sign up for Resend (https://resend.com) and add your API key here
# to enable email notifications in production.
# Development alternative: in-app notifications only (no external service).
RESEND_API_KEY=your_resend_api_key_here

# ---------------------------------------------------------------------------
# Email / Notifications (Generic Service)
# ---------------------------------------------------------------------------
# If using a different email/SMS provider, set the API key here.
# Development alternative: console.log / file-based email stub.
EMAIL_SERVICE_API_KEY=your_email_service_api_key_here

